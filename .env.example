# Copy to .env and fill in values. Never commit .env.

# --- Flask / Web ---
# Port for local `python project_root/app_v2.py` (production uses $PORT from the host)
PORT=5001

# Basic Auth (recommended for shared / production deployments)
# Set BASIC_AUTH_ENABLED=1 to require credentials for all routes.
BASIC_AUTH_ENABLED=0
BASIC_AUTH_USER=user
BASIC_AUTH_PASSWORD=change-me-to-a-strong-password

# --- Scraping (researchmap) ---
# Optional session cookie string, e.g. "session_id=...."
# Prefer env over committing cookie files.
RESEARCHMAP_SESSION_COOKIE=
